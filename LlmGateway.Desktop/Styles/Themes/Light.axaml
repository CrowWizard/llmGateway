<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="SurfaceColor">#F7F8FA</Color>
  <Color x:Key="SurfaceRaisedColor">#FFFFFF</Color>
  <Color x:Key="SurfaceHighlightColor">#F0F3F5</Color>
  <Color x:Key="SurfaceActiveColor">#DDF1ED</Color>
  <Color x:Key="TextColor">#18212A</Color>
  <Color x:Key="TextSubtleColor">#52606D</Color>
  <Color x:Key="TextSubtlestColor">#7C8792</Color>
  <Color x:Key="BorderColor">#D6DCE1</Color>
  <Color x:Key="BorderSubtleColor">#E6EAED</Color>
  <Color x:Key="BorderFocusColor">#319E93</Color>
  <Color x:Key="PrimaryColor">#08796F</Color>
  <Color x:Key="PrimaryHoverColor">#06665E</Color>
  <Color x:Key="PrimaryMutedColor">#E1F2EF</Color>
  <Color x:Key="DangerColor">#C63D36</Color>
  <Color x:Key="DangerMutedColor">#FCEBE9</Color>
  <Color x:Key="SuccessColor">#167B56</Color>
  <Color x:Key="SuccessMutedColor">#E5F5ED</Color>
  <Color x:Key="WarningColor">#A85E08</Color>
  <Color x:Key="WarningMutedColor">#FFF2DB</Color>
  <Color x:Key="LogSurfaceColor">#17212A</Color>
  <Color x:Key="LogTextColor">#DCE6EC</Color>
  <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{DynamicResource SurfaceRaisedColor}" />
  <SolidColorBrush x:Key="SurfaceHighlightBrush" Color="{DynamicResource SurfaceHighlightColor}" />
  <SolidColorBrush x:Key="SurfaceActiveBrush" Color="{DynamicResource SurfaceActiveColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
  <SolidColorBrush x:Key="TextSubtleBrush" Color="{DynamicResource TextSubtleColor}" />
  <SolidColorBrush x:Key="TextSubtlestBrush" Color="{DynamicResource TextSubtlestColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
  <SolidColorBrush x:Key="BorderSubtleBrush" Color="{DynamicResource BorderSubtleColor}" />
  <SolidColorBrush x:Key="BorderFocusBrush" Color="{DynamicResource BorderFocusColor}" />
  <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource PrimaryColor}" />
  <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{DynamicResource PrimaryHoverColor}" />
  <SolidColorBrush x:Key="PrimaryMutedBrush" Color="{DynamicResource PrimaryMutedColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}" />
  <SolidColorBrush x:Key="DangerMutedBrush" Color="{DynamicResource DangerMutedColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" />
  <SolidColorBrush x:Key="SuccessMutedBrush" Color="{DynamicResource SuccessMutedColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}" />
  <SolidColorBrush x:Key="WarningMutedBrush" Color="{DynamicResource WarningMutedColor}" />
  <SolidColorBrush x:Key="LogSurfaceBrush" Color="{DynamicResource LogSurfaceColor}" />
  <SolidColorBrush x:Key="LogTextBrush" Color="{DynamicResource LogTextColor}" />
</ResourceDictionary>
