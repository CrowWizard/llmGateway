<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Double x:Key="ControlHeightSmall">30</x:Double>
  <x:Double x:Key="ControlHeight">36</x:Double>
  <x:Double x:Key="ControlHeightLarge">40</x:Double>
  <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
  <CornerRadius x:Key="RadiusMedium">6</CornerRadius>
  <CornerRadius x:Key="RadiusLarge">8</CornerRadius>
  <Thickness x:Key="WorkspacePadding">28</Thickness>
</ResourceDictionary>
