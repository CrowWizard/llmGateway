<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LlmGateway.Desktop.ViewModels"
        x:Class="LlmGateway.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Codex 配置"
        Icon="/Assets/codex-config.ico"
        Width="1120" Height="720"
        MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="64,*">
    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="24,0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
        <Border Width="34" Height="34" Background="{DynamicResource PrimaryBrush}" CornerRadius="6" VerticalAlignment="Center">
          <TextBlock Text="&gt;_" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="Codex 配置" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Classes="caption" Text="模型、凭据与连接方式" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
          <Border Classes="status-badge">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding GatewayStateText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <Button Classes="primary" Command="{Binding SaveConfigurationCommand}" Content="保存配置" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,28" Spacing="16">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
            <StackPanel Spacing="4">
              <TextBlock FontSize="20" FontWeight="SemiBold" Text="连接配置" />
              <TextBlock Classes="caption" Text="设置 Codex 使用的模型、凭据和连接模式。" />
            </StackPanel>
            <CheckBox Grid.Column="1" Classes="mode-toggle" IsChecked="{Binding CompatibilityMode}" Content="使用本地兼容服务" VerticalAlignment="Center" />
          </Grid>

          <Border Classes="card">
            <StackPanel Spacing="18">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                <StackPanel Spacing="6">
                  <TextBlock Classes="caption" Text="API Key" />
                  <TextBox x:Name="ApiKeyBox" Text="{Binding ApiKey}" PasswordChar="●" RevealPassword="{Binding IsApiKeyVisible}" PlaceholderText="输入 BYOK 令牌" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6">
                  <TextBlock Classes="caption" Text="模型" />
                  <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding Model}" IsEditable="True" />
                </StackPanel>
              </Grid>
              <StackPanel IsVisible="{Binding IsDirectCodexMode}" Spacing="6">
                <TextBlock Classes="caption" Text="Base URL" />
                <TextBox Text="{Binding CodexBaseUrl}" IsReadOnly="True" PlaceholderText="https://api.example.com/v1" VerticalContentAlignment="Center" />
              </StackPanel>
              <StackPanel IsVisible="{Binding IsDirectCodexMode}" Spacing="6">
                <TextBlock Classes="caption" Text="生图 API Key" />
                <TextBox Text="{Binding ImageApiKey}" PasswordChar="●" RevealPassword="{Binding IsApiKeyVisible}" PlaceholderText="输入可访问 gpt-image-2 的令牌" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <Button Classes="secondary" Command="{Binding ValidateImageGenerationCommand}" Content="校验生图服务" />
                  <TextBlock Grid.Column="1" Classes="caption" Text="{Binding ImageGenerationStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
              </StackPanel>
              <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                <Button Classes="secondary" Command="{Binding ToggleApiKeyCommand}" Content="显示 / 隐藏 Key" />
                <Button Grid.Column="1" Classes="secondary" Command="{Binding FetchModelsCommand}" Content="验证并获取模型" />
              </Grid>
            </StackPanel>
          </Border>

          <Border IsVisible="{Binding CompatibilityMode}" Classes="card">
            <StackPanel Spacing="18">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                  <TextBlock Classes="section-title" Text="本地兼容服务" />
                  <TextBlock Classes="caption" Text="将 Responses 请求转换为上游 Chat Completions。" />
                </StackPanel>
                <Border Grid.Column="1" Classes="status-badge">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding GatewayStateText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </Grid>
              <Grid ColumnDefinitions="*,*,2*" ColumnSpacing="12">
                <StackPanel Spacing="6">
                  <TextBlock Classes="caption" Text="监听 IP" />
                  <TextBox Text="{Binding LocalBindIp}" PlaceholderText="127.0.0.1" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6">
                  <TextBlock Classes="caption" Text="端口" />
                  <NumericUpDown Value="{Binding ListenPort}" Minimum="1" Maximum="65535" FormatString="0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="6">
                  <TextBlock Classes="caption" Text="上游 Base URL" />
                  <TextBox Text="{Binding UpstreamBaseUrl}" PlaceholderText="https://api.example.com" VerticalContentAlignment="Center" />
                </StackPanel>
              </Grid>
              <StackPanel Spacing="6">
                <TextBlock Classes="caption" Text="Codex Base URL" />
                <TextBox Text="{Binding EffectiveCodexBaseUrl}" IsReadOnly="True" VerticalContentAlignment="Center" />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <CheckBox IsChecked="{Binding LogTraffic}" Content="记录脱敏运行日志" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Button Classes="secondary" Command="{Binding StartGatewayCommand}" Content="启动服务" />
                  <Button Classes="danger" Command="{Binding StopGatewayCommand}" Content="停止" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="feedback-panel">
            <StackPanel Spacing="4">
              <TextBlock IsVisible="{Binding CompatibilityMode}" Text="{Binding GatewayStatus}" FontSize="12" TextWrapping="Wrap" />
              <TextBlock Text="{Binding CodexStatus}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border IsVisible="{Binding CompatibilityMode}" Classes="card">
            <Grid RowDefinitions="Auto,*" MinHeight="250">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                  <TextBlock Classes="section-title" Text="运行日志" />
                  <TextBlock Classes="caption" Text="敏感请求头会自动脱敏。" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost" Command="{Binding ClearLogsCommand}" Content="清空" />
              </Grid>
              <ListBox Grid.Row="1" Classes="log-list" Margin="0,14,0,0" ItemsSource="{Binding GatewayLogs}" FontFamily="Cascadia Mono, monospace" FontSize="12">
                <ListBox.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource LogTextBrush}" /></DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <Grid ColumnDefinitions="3*,2*" ColumnSpacing="16">
            <Border Classes="card">
              <StackPanel Spacing="14">
                <StackPanel Spacing="4">
                  <TextBlock Classes="section-title" Text="切换配置" />
                  <TextBlock Classes="caption" Text="保存并切换 Codex 配置。" />
                </StackPanel>
                <ComboBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" DisplayMemberBinding="{Binding DisplayName}" PlaceholderText="默认配置" />
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                  <Button Classes="secondary" Command="{Binding RefreshBackupsCommand}" Content="刷新" />
                  <Button Grid.Column="1" Classes="secondary" Command="{Binding RestoreBackupCommand}" Content="切换到所选" />
                  <Button Grid.Column="2" HorizontalAlignment="Right" Classes="ghost" Command="{Binding OpenCodexDirectoryCommand}" Content="打开目录" />
                </Grid>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card">
              <StackPanel Spacing="14">
                <StackPanel Spacing="4">
                  <TextBlock Classes="section-title" Text="工具" />
                  <TextBlock Classes="caption" Text="管理 ChatGPT 和 Codex Skills。" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="8">
                  <Button HorizontalAlignment="Stretch" Classes="primary" Command="{Binding LaunchChatGptCommand}" Content="启动 ChatGPT" />
                  <TextBlock Classes="caption" Text="{Binding ApplicationStatus}" TextWrapping="Wrap" />
                  <Button IsVisible="{Binding CanInstallImagePromptGuide}" HorizontalAlignment="Stretch" Classes="secondary" Command="{Binding InstallImagePromptGuideCommand}" Content="安装电商生图 Skill" />
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
