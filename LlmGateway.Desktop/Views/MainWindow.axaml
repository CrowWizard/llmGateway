<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LlmGateway.Desktop.ViewModels"
        xmlns:models="using:LlmGateway.Desktop.Models"
        x:Class="LlmGateway.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Codex 配置"
        Icon="/Assets/codex-config.ico"
          Width="1040" Height="760"
        MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="64,*">
    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="24,0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
        <Border Width="34" Height="34" Background="{DynamicResource PrimaryBrush}" CornerRadius="6" VerticalAlignment="Center">
          <TextBlock Text="&gt;_" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="Codex 配置" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Classes="caption" Text="模型、凭据与连接方式" />
        </StackPanel>
        <Button Grid.Column="2" Classes="primary" Command="{Binding SaveConfigurationCommand}" Content="保存配置" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,28" Spacing="16">
          <StackPanel Spacing="4">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="连接配置" />
            <TextBlock Classes="caption" Text="设置 Codex 与生图服务使用的模型和凭据。" />
          </StackPanel>

          <Border Classes="card">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Classes="section-title" Text="Ailili" />
                  <TextBlock Classes="caption" Text="在网站中手动注册、登录并创建所需 Key，然后填入下方连接配置。" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="secondary" Command="{Binding OpenAililiWebsiteCommand}" Content="打开网站" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="20">
              <StackPanel Spacing="4">
                <TextBlock Classes="section-title" Text="文字模型" />
                <TextBlock Classes="caption" Text="用于 Codex 对话、代码生成和模型访问。每类模型只能选择一组默认配置。" TextWrapping="Wrap" />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Classes="caption" Text="文字模型配置列表" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="secondary" Command="{Binding FetchModelsCommand}" Content="验证并获取主用模型" />
                <Button Grid.Column="2" Classes="secondary" Command="{Binding AddTextModelGroupCommand}" Content="添加文字模型" />
              </Grid>
              <ItemsControl ItemsSource="{Binding TextModelGroups}">
                <ItemsControl.DataTemplates>
                  <DataTemplate DataType="models:ModelGroupSettings">
                    <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                      <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                          <TextBox Text="{Binding Name}" PlaceholderText="配置名称" />
                          <RadioButton Grid.Column="1" GroupName="text-default-model-group" IsChecked="{Binding IsPrimary, Mode=OneWay}" Command="{Binding $parent[Window].DataContext.SetPrimaryTextModelGroupCommand}" CommandParameter="{Binding}" Content="默认" VerticalAlignment="Center" />
                          <Button Grid.Column="2" Classes="ghost" Command="{Binding $parent[Window].DataContext.RemoveTextModelGroupCommand}" CommandParameter="{Binding}" Content="删除" />
                        </Grid>
                        <TextBox Text="{Binding BaseUrl}" PlaceholderText="https://api.ailili.chat" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                          <TextBox Text="{Binding ApiKey}" PasswordChar="●" RevealPassword="{Binding $parent[Window].DataContext.IsApiKeyVisible}" PlaceholderText="API Key" />
                          <ComboBox Grid.Column="1" ItemsSource="{Binding $parent[Window].DataContext.Models}" Text="{Binding Model, Mode=TwoWay}" IsEditable="True" PlaceholderText="模型" />
                        </Grid>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.DataTemplates>
              </ItemsControl>
              <Button HorizontalAlignment="Left" Classes="ghost" Command="{Binding ToggleApiKeyCommand}" Content="显示 / 隐藏 Key" />

              <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" />

              <StackPanel Spacing="4">
                <TextBlock Classes="section-title" Text="生图" />
                <TextBlock Classes="caption" Text="与文字模型独立配置。网关会将两类模型组汇总到同一 Endpoint 列表。" TextWrapping="Wrap" />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Classes="caption" Text="生图模型配置列表" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="secondary" Command="{Binding FetchImageModelsCommand}" Content="获取主用生图模型" />
                <Button Grid.Column="2" Classes="secondary" Command="{Binding AddImageModelGroupCommand}" Content="添加生图模型" />
              </Grid>
              <ItemsControl ItemsSource="{Binding ImageModelGroups}">
                <ItemsControl.DataTemplates>
                  <DataTemplate DataType="models:ModelGroupSettings">
                    <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                      <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                          <TextBox Text="{Binding Name}" PlaceholderText="配置名称" />
                          <RadioButton Grid.Column="1" GroupName="image-default-model-group" IsChecked="{Binding IsPrimary, Mode=OneWay}" Command="{Binding $parent[Window].DataContext.SetPrimaryImageModelGroupCommand}" CommandParameter="{Binding}" Content="默认" VerticalAlignment="Center" />
                          <Button Grid.Column="2" Classes="ghost" Command="{Binding $parent[Window].DataContext.RemoveImageModelGroupCommand}" CommandParameter="{Binding}" Content="删除" />
                        </Grid>
                        <TextBox Text="{Binding BaseUrl}" PlaceholderText="https://api.ailili.chat" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                          <TextBox Text="{Binding ApiKey}" PasswordChar="●" RevealPassword="{Binding $parent[Window].DataContext.IsApiKeyVisible}" PlaceholderText="API Key" />
                          <ComboBox Grid.Column="1" ItemsSource="{Binding $parent[Window].DataContext.ImageModels}" Text="{Binding Model, Mode=TwoWay}" IsEditable="True" PlaceholderText="生图模型" />
                        </Grid>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.DataTemplates>
              </ItemsControl>
              <TextBlock Classes="caption" Text="{Binding ImageGenerationStatus}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Classes="feedback-panel">
            <StackPanel Spacing="6">
              <TextBox Text="{Binding CodexStatus}"
                       FontSize="12"
                       IsReadOnly="True"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MinHeight="52"
                       BorderThickness="0"
                       Background="Transparent"
                       Padding="0"
                       IsHitTestVisible="True" />
              <TextBlock Classes="caption" Text="{Binding ErrorLogPath, StringFormat='详细操作日志目录：{0}'}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Classes="section-title" Text="本地网关服务" />
                  <TextBlock Classes="caption" Text="LlmGateway CLI 作为 Windows 服务运行；保存网关配置时会自动重启并生效。" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="1" Classes="caption" Text="{Binding GatewayStateText}" VerticalAlignment="Center" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <StackPanel Spacing="6">
                  <TextBlock Classes="caption" Text="上游 Base URL" />
                  <TextBox Text="{Binding UpstreamBaseUrl}" PlaceholderText="https://api.example.com" />
                </StackPanel>
                <StackPanel Grid.Column="1" Width="130" Spacing="6">
                  <TextBlock Classes="caption" Text="监听端口" />
                  <NumericUpDown Minimum="1" Maximum="65535" Value="{Binding ListenPort}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Width="130" Spacing="6">
                  <TextBlock Classes="caption" Text="OAuth issuer 端口" />
                  <NumericUpDown Minimum="1" Maximum="65535" Value="{Binding OAuthPort}" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="6">
                  <TextBlock Classes="caption" Text="监听 IP" />
                  <TextBox Text="{Binding LocalBindIp}" PlaceholderText="127.0.0.1" />
                </StackPanel>
                <CheckBox Grid.Column="1" IsChecked="{Binding LogTraffic}" Content="记录代理流量" VerticalAlignment="Bottom" />
              </Grid>
              <StackPanel Spacing="6">
                <TextBlock Classes="caption" Text="日志级别" />
                <ComboBox SelectedItem="{Binding LogLevel}">
                  <x:String>Error</x:String>
                  <x:String>Information</x:String>
                  <x:String>Debug</x:String>
                </ComboBox>
              </StackPanel>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="caption" Text="本地 Gateway API Key" />
                    <TextBox Text="{Binding GatewayApiKey}" IsReadOnly="True" PasswordChar="●" RevealPassword="{Binding IsApiKeyVisible}" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="ghost" Command="{Binding RegenerateGatewayApiKeyCommand}" Content="重新生成 Key" VerticalAlignment="Bottom" />
                </Grid>
              <StackPanel Spacing="6">
                <TextBlock Classes="caption" Text="Responses 映射" />
                <ComboBox SelectedItem="{Binding ResponsesMode}" IsEditable="True">
                  <x:String>Auto</x:String>
                  <x:String>Responses</x:String>
                  <x:String>ChatCompletions</x:String>
                </ComboBox>
              </StackPanel>
              <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
                <Button Classes="secondary" Command="{Binding ToggleGatewayServiceCommand}" Content="{Binding ServiceActionText}" />
                <Button Grid.Column="1" Classes="ghost" Command="{Binding InstallGatewayServiceCommand}" Content="{Binding ServiceInstallText}" />
                <CheckBox Grid.Column="2" IsChecked="{Binding IsServiceAutomaticStart, Mode=OneWay}" Command="{Binding ToggleAutomaticStartCommand}" Content="随系统启动" IsEnabled="{Binding IsServiceInstalled}" VerticalAlignment="Center" />
                <Button Grid.Column="3" HorizontalAlignment="Right" Classes="ghost" Command="{Binding RefreshGatewayStatusCommand}" Content="刷新状态" />
              </Grid>
              <TextBlock Classes="caption" Text="{Binding GatewayStatus}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
            <Border Classes="card">
              <StackPanel Spacing="14">
                <StackPanel Spacing="4">
                  <TextBlock Classes="section-title" Text="切换配置" />
                  <TextBlock Classes="caption" Text="保存并切换 Codex 配置。" />
                </StackPanel>
                <ComboBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" DisplayMemberBinding="{Binding DisplayName}" PlaceholderText="默认配置" />
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                  <Button Classes="secondary" Command="{Binding RefreshBackupsCommand}" Content="刷新" />
                  <Button Grid.Column="1" Classes="secondary" Command="{Binding RestoreBackupCommand}" Content="切换到所选" />
                  <Button Grid.Column="2" HorizontalAlignment="Right" Classes="ghost" Command="{Binding OpenCodexDirectoryCommand}" Content="打开目录" />
                </Grid>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card">
              <StackPanel Spacing="14">
                <StackPanel Spacing="4">
                  <TextBlock Classes="section-title" Text="客户端" />
                  <TextBlock Classes="caption" Text="启动已安装的 ChatGPT 客户端。" TextWrapping="Wrap" />
                </StackPanel>
                <Button HorizontalAlignment="Stretch" Classes="secondary" Command="{Binding LaunchChatGptCommand}" Content="启动 ChatGPT" />
                <TextBlock Classes="caption" Text="{Binding ApplicationStatus}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Grid>

          <Border Classes="card">
            <StackPanel Spacing="14">
              <StackPanel Spacing="4">
                <TextBlock Classes="section-title" Text="安装组件" />
                <TextBlock Classes="caption" Text="安装电商与兼容版生图 Skill，共用应用托管的 Node.js 运行环境。" TextWrapping="Wrap" />
              </StackPanel>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Button HorizontalAlignment="Stretch" Classes="secondary" Command="{Binding EnsureNodeCommand}" Content="安装 Node 运行时" />
                <Button Grid.Column="1" HorizontalAlignment="Stretch" Classes="secondary" Command="{Binding InstallEcommerceImageStudioCommand}" IsEnabled="{Binding !IsNodeInstalling}" Content="安装电商生图 Skill" />
                <Button Grid.Column="2" HorizontalAlignment="Stretch" Classes="secondary" Command="{Binding InstallImageGenAutoCommand}" IsEnabled="{Binding !IsNodeInstalling}" Content="安装兼容版生图 Skill" />
              </Grid>
              <StackPanel Spacing="4" IsVisible="{Binding IsNodeInstalling}">
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding NodeInstallProgress}" Height="8" />
                <TextBlock Classes="caption" Text="{Binding NodeInstallStatus}" TextWrapping="Wrap" />
              </StackPanel>
              <Button HorizontalAlignment="Stretch" Classes="secondary" Command="{Binding EnableChineseLocalizationCommand}" Content="启用 Codex 界面汉化" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
