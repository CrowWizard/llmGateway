{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "Gateway": {
    "LocalBindIp": "0.0.0.0",
    "ListenPort": 23001,
    "ApiKey": "",
    "UpstreamBaseUrl": "https://api.ailili.chat",
    "CompatibilityMode": false,
    "ResponsesMode": "Auto",
    "GeminiImageApiKey": "",
    "DirectCodexBaseUrl": "https://api.ailili.chat/v1",
    "ExtraRequestHeaders": {
      "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.8"
    },
    "EndpointMappings": {
      "/v1/images/generations": "/v1/images/generations",
      "/v1/images/edits": "/v1/images/edits"
    },
    "Endpoints": [
      {
        "Name": "ailili",
        "BaseUrl": "https://api.ailili.chat",
        "ApiKey": "",
        "Enabled": true
      }
    ],
    "LogTraffic": true
  }
}
